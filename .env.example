# Copiez ce fichier vers .env :  cp .env.example .env
# .env est ignore par git ET par le contexte Docker (.dockerignore).

# --- Base de donnees -------------------------------------------------------
# Chemin utilise HORS Docker (drizzle-kit, npm run dev, npm run db:seed).
# Un fichier a la racine du depot, ignore par git.
#
# En Docker, cette valeur n'est PAS lue : docker-compose.yml impose
# file:/data/profilsactifs.db, ou /data est le volume nomme db-data-{dev,prod}.
# Ne pas remettre /data ici : ce repertoire n'existe pas sur l'hote et toutes
# les commandes locales echoueraient sur « Cannot open database because the
# directory does not exist ».
DATABASE_URL=file:./local.db

# --- better-auth -----------------------------------------------------------
# Generez la votre :  openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGEZ_MOI_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port expose sur l'hote (le conteneur ecoute toujours sur 3000 en interne)
PORT=3000
