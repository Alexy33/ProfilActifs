# Copiez ce fichier vers .env :  cp .env.example .env
# .env est ignore par git ET par le contexte Docker (.dockerignore).

# --- Base de donnees -------------------------------------------------------
# Chemin DANS le conteneur. /data est le volume nomme "db-data".
# Ne pas pointer vers ./data : le fichier serait perdu a chaque rebuild.
DATABASE_URL=file:/data/profilsactifs.db

# --- better-auth -----------------------------------------------------------
# Generez la votre :  openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGEZ_MOI_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port expose sur l'hote (le conteneur ecoute toujours sur 3000 en interne)
PORT=3000
